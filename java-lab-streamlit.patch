new file mode 100644
index 0000000..2e1802b
--- /dev/null
+++ b/apps/labcore/jdk.py
@@ -0,0 +1,136 @@
+"""A Java 21 JDK for the student app.
+
+Streamlit Community Cloud runs on Debian 11, whose packages stop at Java 17, while the gradebook
+marks with Eclipse Temurin 21 (lab-system/grader). The app therefore downloads the same Temurin 21
+JDK once per container start, checks its SHA-256 and unpacks it into a cache folder.
+
+Order of preference: $LAB_JAVA_HOME, the cached Temurin download, a JDK 21+ already on PATH.
+"""
+import hashlib
+import os
+import platform
+import shutil
+import subprocess
+import tarfile
+import tempfile
+import urllib.request
+
+VERSION = "21.0.13+9"
+SHA256 = {  # from the .sha256.txt files published with the release
+    "x64": "d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c",
+    "aarch64": "e3522e707fc7dbe2a72c30746b1e7068301a0213ecd213d4491f35a14eb55578",
+}
+ARCH = {"x86_64": "x64", "amd64": "x64", "aarch64": "aarch64", "arm64": "aarch64"}
+
+
+class JdkError(RuntimeError):
+    pass
+
+
+def _url(arch):
+    tag = "jdk-" + VERSION.replace("+", "%2B")
+    name = "OpenJDK21U-jdk_%s_linux_hotspot_%s.tar.gz" % (arch, VERSION.replace("+", "_"))
+    return "https://github.com/adoptium/temurin21-binaries/releases/download/%s/%s" % (tag, name)
+
+
+def cache_dir():
+    base = os.environ.get("LAB_CACHE") or os.path.join(os.path.expanduser("~"), ".cache", "javalab")
+    try:
+        os.makedirs(base, exist_ok=True)
+        probe = os.path.join(base, ".w")
+        open(probe, "w").close()
+        os.remove(probe)
+        return base
+    except OSError:
+        base = os.path.join(tempfile.gettempdir(), "javalab")
+        os.makedirs(base, exist_ok=True)
+        return base
+
+
+def _major(java_home):
+    """Feature version of the JDK at java_home (e.g. 21), or 0 when it is not a usable JDK."""
+    javac = os.path.join(java_home, "bin", "javac")
+    java = os.path.join(java_home, "bin", "java")
+    if not (os.access(javac, os.X_OK) and os.access(java, os.X_OK)):
+        return 0
+    try:
+        out = subprocess.run([java, "-XshowSettings:properties", "-version"], capture_output=True,
+                             text=True, timeout=60).stderr
+    except (OSError, subprocess.SubprocessError):
+        return 0
+    for line in out.splitlines():
+        line = line.strip()
+        if line.startswith("java.specification.version ="):
+            try:
+                return int(line.split("=", 1)[1].strip())
+            except ValueError:
+                return 0
+    return 0
+
+
+def _download(arch, dest, log):
+    url = _url(arch)
+    log("Downloading Temurin %s (%s) ..." % (VERSION, arch))
+    tmp = dest + ".part"
+    digest = hashlib.sha256()
+    req = urllib.request.Request(url, headers={"User-Agent": "java-lab-streamlit"})
+    with urllib.request.urlopen(req, timeout=120) as r, open(tmp, "wb") as f:
+        while True:
+            chunk = r.read(1 << 20)
+            if not chunk:
+                break
+            digest.update(chunk)
+            f.write(chunk)
+    if digest.hexdigest() != SHA256[arch]:
+        os.remove(tmp)
+        raise JdkError("checksum mismatch for %s" % url)
+    os.replace(tmp, dest)
+
+
+def _safe_extract(archive, target):
+    with tarfile.open(archive, "r:gz") as tar:
+        root = os.path.realpath(target)
+        for m in tar.getmembers():
+            p = os.path.realpath(os.path.join(target, m.name))
+            if os.path.commonpath([root, p]) != root:
+                raise JdkError("unsafe path in archive: %s" % m.name)
+        try:
+            tar.extractall(target, filter="tar")
+        except TypeError:  # Python < 3.12 without extraction filters
+            tar.extractall(target)
+
+
+def ensure_jdk(log=lambda msg: None):
+    """Returns JAVA_HOME of a JDK 21 or newer; downloads Temurin 21 if needed."""
+    env_home = os.environ.get("LAB_JAVA_HOME")
+    if env_home and _major(env_home) >= 21:
+        return env_home
+    arch = ARCH.get(platform.machine().lower())
+    base = cache_dir()
+    home = os.path.join(base, "jdk-" + VERSION)
+    if _major(home) >= 21:
+        return home
+    if arch:
+        try:
+            archive = os.path.join(base, "temurin-%s-%s.tar.gz" % (VERSION.replace("+", "_"), arch))
+            if not os.path.exists(archive):
+                _download(arch, archive, log)
+            work = tempfile.mkdtemp(dir=base)
+            _safe_extract(archive, work)
+            tops = [d for d in os.listdir(work) if os.path.isdir(os.path.join(work, d))]
+            if len(tops) != 1:
+                raise JdkError("unexpected archive layout")
+            shutil.rmtree(home, ignore_errors=True)
+            os.replace(os.path.join(work, tops[0]), home)
+            shutil.rmtree(work, ignore_errors=True)
+            os.remove(archive)
+            if _major(home) >= 21:
+                return home
+        except (OSError, JdkError, tarfile.TarError) as e:
+            log("Temurin download failed: %s" % e)
+    javac = shutil.which("javac")
+    if javac:
+        cand = os.path.dirname(os.path.dirname(os.path.realpath(javac)))
+        if _major(cand) >= 21:
+            return cand
+    raise JdkError("no Java 21 JDK available (download failed and none on PATH)")
diff --git a/apps/labcore/labdata.py b/apps/labcore/labdata.py
new file mode 100644
index 0000000..763beb0
--- /dev/null
+++ b/apps/labcore/labdata.py
@@ -0,0 +1,218 @@
+"""Lab data read by both apps: course catalog, questions with sample cases, lab/control.json and
+the teacher's public key.
+
+control.json and the key change during a lab (the "Lab session control" workflow commits them),
+so they are read from GitHub (raw.githubusercontent.com) by the app server, not by every
+browser: one request per TTL for the whole class instead of one per student per minute. The
+copy in the app's own checkout is the fallback. Questions come from the checkout first and from
+GitHub when a question was committed after the app last updated.
+"""
+import json
+import os
+import re
+import threading
+import time
+import urllib.error
+import urllib.request
+from dataclasses import dataclass, field
+
+from . import ROOT
+import control as ctl  # tools/lab/control.py
+
+REPO = os.environ.get("LAB_REPO", "parthiban-loganathan/Java")
+BRANCH = os.environ.get("LAB_BRANCH", "main")
+RAW = "https://raw.githubusercontent.com/%s/%s/" % (REPO, BRANCH)
+ID = re.compile(r"^[A-Za-z0-9_-]{1,32}$")
+DEFAULT_REGNO = r"^[0-9]{2}[A-Z]{3}[0-9]{4}$"
+
+
+@dataclass
+class Question:
+    id: str
+    title: str
+    markdown: str
+    cases: list                      # [(input, expected)]
+    folder: str = ""                 # local folder (setup.sql of Experiment 16), "" when fetched
+    kind: str = "lab"                # lab | lesson | experiment
+    note: str = ""
+    requires: str = ""
+    files: dict = field(default_factory=dict)   # reference sources (course programs only)
+
+
+# ---------------------------------------------------------------------- small cached fetcher
+_cache = {}
+_cache_lock = threading.Lock()
+
+
+def fetch_text(path, ttl):
+    """Text of a repository file from GitHub, cached ttl seconds; None when missing or offline."""
+    now = time.monotonic()
+    with _cache_lock:
+        hit = _cache.get(path)
+        if hit and now - hit[0] < ttl:
+            return hit[1]
+    try:
+        req = urllib.request.Request(RAW + path, headers={"User-Agent": "java-lab-streamlit", "Cache-Control": "no-cache"})
+        with urllib.request.urlopen(req, timeout=10) as r:
+            text = r.read().decode("utf-8")
+    except urllib.error.HTTPError as e:
+        if e.code != 404:                      # rate limit or outage: keep what we had
+            return hit[1] if hit else None
+        text = None                            # the file does not exist (cached as such)
+    except (urllib.error.URLError, OSError, UnicodeDecodeError):
+        return hit[1] if hit else None
+    with _cache_lock:
+        _cache[path] = (now, text)
+    return text
+
+
+def local_text(path):
+    p = os.path.join(ROOT, path)
+    try:
+        with open(p, encoding="utf-8") as f:
+            return f.read()
+    except OSError:
+        return None
+
+
+# ---------------------------------------------------------------------- control.json and key
+def control(ttl=20):
+    """(data, source): lab/control.json from GitHub (fresh within ttl s) or the local copy."""
+    text = fetch_text("lab/control.json", ttl)
+    source = "GitHub"
+    if text is None:
+        text, source = local_text("lab/control.json"), "local copy"
+    try:
+        data = json.loads(text) if text else ctl.empty()
+    except ValueError:
+        data, source = ctl.empty(), "unreadable"
+    data.setdefault("sessions", [])
+    data.setdefault("settings", {})
+    return data, source
+
+
+def public_key(ttl=60):
+    text = fetch_text("lab/teacher-public-key.pem", ttl) or local_text("lab/teacher-public-key.pem")
+    return text if text and "BEGIN PUBLIC KEY" in text else None
+
+
+def regno_pattern(data):
+    try:
+        return re.compile((data.get("settings") or {}).get("regnoPattern") or DEFAULT_REGNO)
+    except re.error:
+        return re.compile(DEFAULT_REGNO)
+
+
+def utcnow():
+    import datetime as dt
+    return dt.datetime.now(dt.timezone.utc)
+
+
+def open_sessions(data, now=None):
+    """[(session, window)] open now, by the same rule as intake and gradebook."""
+    return ctl.open_windows(data, now or utcnow())
+
+
+def window_end(w):
+    return ctl.window_end(w)
+
+
+# ---------------------------------------------------------------------- course catalog
+def _props(path):
+    out = {}
+    text = local_text(os.path.relpath(path, ROOT)) or ""
+    for line in text.splitlines():
+        line = line.strip()
+        if line and not line.startswith("#") and "=" in line:
+            k, v = line.split("=", 1)
+            out[k.strip()] = v.strip()
+    return out
+
+
+def _cases_in(folder):
+    cases, n = [], 1
+    while True:
+        suf = "" if n == 1 else "-%d" % n
+        exp = os.path.join(folder, "expected%s.txt" % suf)
+        if not os.path.exists(exp):
+            return cases
+        inp = os.path.join(folder, "input%s.txt" % suf)
+        with open(exp, encoding="utf-8") as f:
+            e = f.read()
+        i = ""
+        if os.path.exists(inp):
+            with open(inp, encoding="utf-8") as f:
+                i = f.read()
+        cases.append((i, e))
+        n += 1
+
+
+_catalog = None
+
+
+def catalog():
+    """Course programs in order: [{"id", "title", "kind", "folder", "requires", "order"}]."""
+    global _catalog
+    if _catalog is None:
+        items = []
+        for group in ("lessons", "experiments"):
+            base = os.path.join(ROOT, "course", group)
+            if not os.path.isdir(base):
+                continue
+            for d in sorted(os.listdir(base)):
+                folder = os.path.join(base, d)
+                meta = os.path.join(folder, "meta.properties")
+                if os.path.exists(meta):
+                    m = _props(meta)
+                    items.append({"id": d.split("-")[0], "title": m.get("title", d), "kind": m.get("kind", group[:-1]),
+                                  "folder": folder, "requires": m.get("requires", ""),
+                                  "order": (0 if group == "lessons" else 1, int(m.get("order", "0") or 0))})
+        items.sort(key=lambda x: x["order"])
+        _catalog = items
+    return _catalog
+
+
+def course_ids():
+    return [p["id"] for p in catalog()]
+
+
+def question(qid):
+    """Question by id: a course program (L07, E05a) or lab/questions/<ID>. None when unknown."""
+    if not ID.match(qid or ""):
+        return None
+    p = next((x for x in catalog() if x["id"] == qid), None)
+    if p:
+        folder = p["folder"]
+        md = local_text(os.path.relpath(os.path.join(folder, "README.md"), ROOT)) or "# " + p["title"]
+        files = {}
+        for f in sorted(os.listdir(folder)):
+            if f.endswith(".java"):
+                files[f] = local_text(os.path.relpath(os.path.join(folder, f), ROOT)) or ""
+        note = ""
+        if p["requires"] == "mysql":
+            note = ("This program uses a database. Here it runs against an in-memory database in MySQL mode that "
+                    "setup.sql prepares for every run; the gradebook marks it on the real JDK as usual.")
+        return Question(qid, p["title"], md, _cases_in(folder), folder, p["kind"], note, p["requires"], files)
+    base = "lab/questions/%s/" % qid
+    folder = os.path.join(ROOT, base)
+    if os.path.isfile(os.path.join(folder, "README.md")):
+        md = local_text(base + "README.md")
+        cases = _cases_in(folder)
+    else:
+        md = fetch_text(base + "README.md", 60)
+        if md is None:
+            return None
+        folder, cases = "", []
+        for n in range(1, 11):
+            suf = "" if n == 1 else "-%d" % n
+            exp = fetch_text(base + "expected%s.txt" % suf, 60)
+            if exp is None:
+                break
+            cases.append((fetch_text(base + "input%s.txt" % suf, 60) or "", exp))
+    m = re.search(r"^#\s+(.+)$", md or "", re.M)
+    return Question(qid, m.group(1).strip() if m else qid, md or "", cases, folder, "lab")
+
+
+def question_title(qid):
+    q = question(qid)
+    return q.title if q else qid
