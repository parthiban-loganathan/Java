+    permission java.io.FilePermission "${lab.work}${/}-", "read,write,delete";
+    permission java.util.PropertyPermission "*", "read";
+    permission java.lang.RuntimePermission "exitVM.*";
+    permission java.lang.RuntimePermission "getenv.DB_URL";
+    permission java.lang.RuntimePermission "getenv.DB_USER";
